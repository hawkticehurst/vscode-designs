{
  "tag": "vsc-customization-discovery-card",
  "kind": "component",
  "title": "Discovery card",
  "category": "chat",
  "description": "A marketplace result on the Browse page (`.customization-discovery-card`): 40px icon, name with muted type · source metadata, a one-line description and a small secondary Install button. The whole card is a View details button.",
  "usage": "Inside <vsc-customization-discovery-section>.",
  "attributes": [
    {
      "name": "name",
      "type": "string"
    },
    {
      "name": "meta",
      "type": "string",
      "description": "Type · Source, e.g. \"MCP server · GitHub Feed\"."
    },
    {
      "name": "description",
      "type": "string"
    },
    {
      "name": "icon-src",
      "type": "string",
      "description": "Icon image URL (40px); without it the codicon fallback shows."
    },
    {
      "name": "fallback-icon",
      "type": "string",
      "default": "extensions",
      "description": "Codicon when there's no image: extensions (plugin), server (MCP), lightbulb (skill)."
    },
    {
      "name": "action",
      "type": "string",
      "default": "Install"
    }
  ],
  "slots": [],
